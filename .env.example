# --- Transport ---
# stdio (default; spawned by an MCP client) or http (standalone service on PORT, endpoint /mcp)
MCP_TRANSPORT=http
PORT=3333
HOST=0.0.0.0
# Bearer token clients must send when MCP_TRANSPORT=http (openssl rand -hex 32). Strongly recommended.
MCP_AUTH_TOKEN=

# --- Facebook session (pick one) ---
# 1) macOS Chrome profile folder (Default, "Profile 1", ...) — needs Chrome + Keychain on this machine
CHROME_PROFILE=Default
# 2) cookie export file (JSON from a cookie extension, or Netscape cookies.txt)
FACEBOOK_COOKIES_FILE=
# 3) the same data inline, raw JSON or base64 (for container environments)
FACEBOOK_COOKIES_JSON=

# Facebook host; some accounts are served from web.facebook.com
FACEBOOK_HOST=www.facebook.com
MAX_REQUESTS_PER_MINUTE=3
